# Odin Connect + canister configuration. Copy to `.env` and adjust.
# Every value below is optional; the defaults match the deployed setup.

# App name shown in the Odin approval popup.
VITE_ODIN_APP_NAME="Galleon Stakes"

# Odin environment: prod | staging | dev | local | legacy
# Any other value fails at startup with a clear error. Must match the ledger
# the game canister was deployed with (dev ledger ↔ dev env).
VITE_ODIN_ENV=dev

# Game canister principal — ICRC-2 spender, delegation target, actor target.
# Default: the mainnet canister (deployed against the Odin dev ledger) when
# VITE_DFX_NETWORK is ic. After a local `dfx deploy`, leave this unset to pick
# up the id from the root `.env` automatically; a local build with no id
# shows "Canister not configured" instead of falling back to mainnet.
VITE_APP_CANISTER_ID=gkvcg-5aaaa-aaaae-qkpzq-cai

# dfx network the canister lives on: ic (default) | local
VITE_DFX_NETWORK=ic

# Odin token id staked by the game.
VITE_TOKEN_ID=hjun

# Principals shown the treasury deposit form (comma-separated, your Odin
# login principal). UI gate only; the canister's fund_pool accepts any
# caller's own approved tokens.
VITE_ADMIN_PRINCIPALS=

# Sats the Treasury "Buy" button spends per click.
VITE_BUY_SATS=20000

# IC boundary host. Defaults to https://icp0.io (ic) / http://127.0.0.1:4943 (local).
# VITE_IC_HOST=
