# Odin Connect + canister configuration (all optional — defaults below apply).
# Copy to `.env` and adjust for your environment.

# App name shown in the Odin approval popup.
VITE_ODIN_APP_NAME="Galleon Stakes"

# Odin environment: prod | staging | dev | local | legacy
# Any other value fails at startup with a clear error.
VITE_ODIN_ENV=dev

# Staking canister principal — delegation target + actor target.
VITE_STAKING_CANISTER_ID=sfgyi-iyaaa-aaaam-qepyq-cai

# Odin token id staked by the game.
VITE_TOKEN_ID=2j5i

# IC boundary host (mainnet).
# VITE_IC_HOST=https://icp0.io
