# Odin Connect + canister configuration (all optional — defaults below apply).
# Copy to `.env` and adjust for your environment.

# App name shown in the Odin approval popup.
VITE_ODIN_APP_NAME="Galleon Stakes"

# Odin environment: prod | staging | dev | local | legacy
# Any other value fails at startup with a clear error. Must match the ledger
# the game canister was deployed with (dev ledger ↔ dev env).
VITE_ODIN_ENV=dev

# Game canister principal — ICRC-2 spender, delegation target, actor target.
# After `dfx deploy` the id is picked up automatically from the root `.env`;
# set this to override it (e.g. the mainnet id while developing locally).
# VITE_APP_CANISTER_ID=

# dfx network the canister lives on: ic (default) | local
# VITE_DFX_NETWORK=ic

# Odin token id staked by the game.
VITE_TOKEN_ID=hjun

# IC boundary host. Defaults to https://icp0.io (ic) / http://127.0.0.1:4943 (local).
# VITE_IC_HOST=
